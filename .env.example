# Vocaburn Production Environment Variables
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_64_character_hex_key_in_production

# CentralAuth & SSO
CENTRAL_AUTH_URL=https://auth.inmind.site
CENTRALAUTH_INTERNAL_URL=http://127.0.0.1:5050
CENTRALAUTH_QUEUE_TOKEN=super-secret-token-123
QUEUE_API_SECRET=super-secret-token-123
CLIENT_ID=vocaburn-v1
CLIENT_SECRET=vocaburn_secret_123
APP_BASE_URL=https://vocab.inmind.site

# AI
GEMINI_API_KEY=
